#Faire une analyse de causalité de Granger (fonction causality() sur l’objet VAR).

#Récupérer les résidus pour des tests de normalité, autocorrélation.

# Afficher les impulsions/réponses (irf(var_model)), décomposition de variance (fevd(var_model)).


################# Modélisation var
library(vars)

Y <- data.frame(
  d_inflation = diff(Data$IPC),
  d_usdtry = diff(Data$`USD/TRY`),
  d_cds = diff(Data$CDS)
)

# Choix du lag 

lags <- VARselect(Y, lag.max = 4, type = "const")
lags$criteria

var_model <- VAR(Y, p=1, type="const")

summary(var_model)


# Test d'autocorrélation 

# Test d’autocorrélation des résidus du VAR (Ljung-Box)
residus <- resid(var_model)

for (nom_var in colnames(residus)) {
  cat("\nAutocorrélation des résidus pour ", nom_var, ":\n")
  print(Box.test(residus[, nom_var], lag = 10, type = "Ljung-Box"))
}

# Interprétation :
# p-value > 0.05 : pas d'autocorrélation → modèle OK
# p-value < 0.05 : autocorrélation détectée → attention, peut-être revoir ton VAR !


# Test de stabilité du model 

# Afficher les racines du modèle
mod_stab <- stability(var_model)
summary(mod_stab)
# Toutes les valeurs doivent être < 1 pour assurer la stabilité dynamique

plot(mod_stab)

summary(var_model)$roots
plot(Mod(summary(var_model)$roots), 
     main="Modulus of VAR Characteristic Roots",
     ylab="Modulus",
     xlab="Root Number",
     pch=19)
abline(h=1, col="red", lwd=2, lty=2) # La ligne rouge montre la limite de stabilité

# Toutes les valeurs doivent être < 1 pour assurer la stabilité dynamique

# Tu peux également regarder summary(var_model)$roots : toutes doivent être < 1


# Test de Granger

# Test de causalité de Granger pour chaque variable prise comme "cause"
library(vars)

for (nom_var in colnames(Y)) {
  cat("\nTest de causalité de Granger pour ", nom_var, ":\n")
  print(causality(var_model, cause = nom_var)$Granger)
}

# Interprétation :
# p-value < 0.05 : la variable "cause" exerce une causalité Granger significative sur le système.
# p-value > 0.05 : pas de causalité Granger détectée.



# Fonction de reponse 

# Calculer et afficher toutes les IRF possibles
for (impulse_var in colnames(Y)) {
  for (response_var in colnames(Y)) {
    cat("\nIRF : Choc sur", impulse_var, "→ Réponse de", response_var, "\n")
    irf_res <- irf(var_model, impulse = impulse_var, response = response_var,
                   n.ahead = 10, boot = TRUE)
    plot(irf_res)
  }
}




