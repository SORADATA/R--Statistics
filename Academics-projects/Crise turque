# Libraries nécessaires
library(dplyr)
library(moments)
library(tidyr)
library(knitr)

# Conversion date pour le format "2017M01"
Data <- Data %>%
  mutate(
    Year = as.numeric(substr(Time, 1, 4)),
    Month = as.numeric(substr(Time, 6, 7)),
    Date = as.Date(paste0(Year, "-", Month, "-01"))
  )

# Découpage en période
Data <- Data %>%
  mutate(
    Periode = case_when(
      Date < as.Date("2018-06-01") ~ "Avant crise",
      Dummy_crise == 1             ~ "Pendant crise",
      Date > as.Date("2019-01-01") ~ "Après crise"
    )
  )

# Variables macro/financières à analyser
vars <- c("IPC", "USD/TRY", "CDS", "Taux de chomage", "Taux directeur(%)", "SP500", "DAX", "Hang Seng")

# Fonction stats par sous-période
stats_period <- function(df, variables) {
  summarise(df,
            across(all_of(variables),
                   list(
                     mean = ~mean(., na.rm=TRUE),
                     median = ~median(., na.rm=TRUE),
                     sd = ~sd(., na.rm=TRUE),
                     min = ~min(., na.rm=TRUE),
                     max = ~max(., na.rm=TRUE),
                     skew = ~skewness(., na.rm=TRUE),
                     kurt = ~kurtosis(., na.rm=TRUE)
                   ),
                   .names = "{.col}_{.fn}"
            )
  )
}

# Création du tableau final
stats_desc <- Data %>%
  filter(!is.na(Periode)) %>%
  group_by(Periode) %>%
  do(stats_period(., vars)) %>%
  pivot_longer(
    -Periode,
    names_to = c("Variable", "Stat"),
    names_sep = "_"
  ) %>%
  pivot_wider(names_from = Stat, values_from = value) %>%
  arrange(factor(Periode, levels = c("Avant crise", "Pendant crise", "Après crise")), Variable)

# Affichage joli tableau (optionnel)
kable(stats_desc, digits=2, caption="Statistiques descriptives par période")

# Export csv (optionnel)
write.csv(stats_desc, "stats_descriptives_par_periode.csv", row.names=FALSE)


library(kableExtra)

